{
  "name": "@agentos/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "agentos": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts server --embedded-runner",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --no-warnings=ExperimentalWarning dist/cli.js server",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
